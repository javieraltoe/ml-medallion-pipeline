# Copiar a .env (make setup lo hace por vos). NUNCA subir .env a GitHub.

# Linux: tu UID para que los archivos creados por Airflow sean tuyos (make setup lo completa)
AIRFLOW_UID=50000
AIRFLOW_JWT_SECRET=local-dev-only-change-me

# sample = datos sintéticos (sin credenciales) | api = API real de Mercado Libre
ML_SOURCE_MODE=sample
ML_SITES=MLA,MLB,MLM
ML_SEARCH_TERMS=celular,notebook,zapatillas
ML_MAX_ITEMS_PER_TERM=200

# Escenarios de demo en modo sample: volume_drop | schema_break | (vacío)
ML_SAMPLE_SCENARIO=

# --- Sólo para ML_SOURCE_MODE=api (ver docs/mercadolibre_api.md) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=
# Alternativa rápida para probar: un access token vigente (dura ~6 horas)
ML_ACCESS_TOKEN=
